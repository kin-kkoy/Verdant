# --- Verdant environment ---
# Copy to .env.local and fill in. .env.local is gitignored.

# Neon Postgres — use the POOLED connection string (…-pooler.…) for serverless.
# Get it from the Neon dashboard → Connection Details → "Pooled connection".
DATABASE_URL="postgres://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require"

# Auth.js session signing secret. Generate one with:  npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-string"

# Owner's login name — gates the /requests admin page (approving access requests).
# If unset, the first-created account is treated as the owner.
OWNER_NAME=""

# --- Web Push notifications (Chunk B) ---
# Generate a key pair with:  npm run vapid   then paste all four values here.
# PRIVATE key is server-only; the PUBLIC key is exposed to the browser to subscribe.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# Shared secret protecting the /api/cron/nudge endpoint. An external scheduler
# (e.g. cron-job.org) pings that URL every 30 min and must send this as an
# `Authorization: Bearer <CRON_SECRET>` header. Generate:  openssl rand -base64 32
CRON_SECRET=""

# --- Deferred (leave blank until the relevant phase) ---
# Vercel Blob (Phase 2 — journal photos)
# BLOB_READ_WRITE_TOKEN=""

# Optional Google login/recovery (Phase 1+, optional)
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""
